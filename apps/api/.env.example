# Copy to .env for local dev. .env is gitignored.
PORT=3000
DATABASE_URL="postgresql://invoice:invoice@localhost:5432/invoice?schema=public"
# The only browser origin allowed to call the API with credentials (the frontend).
CORS_ORIGIN="http://localhost:5173"
# Signs the session cookie. Any long random string; REQUIRED in production
# (generate one with: openssl rand -hex 32).
SESSION_SECRET="dev-only-secret"
# First admin account, created by `npm run db:seed`. Change the password!
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Admin"
